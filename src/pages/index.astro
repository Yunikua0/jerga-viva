---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { dayIndex } from "../lib/text";
import { CATEGORIES, CATEGORY_LABELS } from "../lib/word-schema";

const words = await getCollection("words");
const list = words
  .map((entry) => ({
    id: entry.id,
    term: entry.data.term,
    definition: entry.data.definition,
  }))
  .sort((a, b) => a.id.localeCompare(b.id));
const daily = list[dayIndex(new Date(), list.length)];
const categories = CATEGORIES.map((id) => ({
  id,
  label: CATEGORY_LABELS[id],
  count: words.filter((entry) => entry.data.category === id).length,
}));
---
<Base
  title="Jerga Viva — diccionario de jerga moderna en español"
  description="Significado, ejemplos y origen de la jerga moderna en español: redes sociales, Gen Z, gaming y relaciones."
  path="/"
>
  <h1>Jerga Viva: el diccionario de la jerga moderna</h1>
  <span aria-hidden="true" class="mt-3 block h-1.5 w-32 rounded-full bg-accent"></span>
  <p class="mt-6 max-w-[40rem] text-lg">
    ¿Viste una palabra en un comentario y no la entiendes? Aquí tienes su significado en dos
    frases, con ejemplos y origen.
  </p>
  <p class="mt-4">
    <a
      href="/buscar/"
      class="inline-flex min-h-11 items-center rounded-full bg-primary px-6 font-bold text-primary-fg no-underline transition-transform duration-150 ease-out hover:-translate-y-0.5"
    >
      Buscar una palabra
    </a>
  </p>

  <section
    aria-labelledby="daily-title"
    data-daily
    class="mt-10 rounded-2xl border-2 border-border bg-surface p-6 shadow-[var(--shadow-card)]"
  >
    <h2 id="daily-title">Palabra del día</h2>
    <p class="mt-3 text-2xl">
      <a data-daily-link href={`/palabra/${daily?.id}/`} class="font-display font-bold">{daily?.term}</a>
    </p>
    <p data-daily-definition class="mt-2">{daily?.definition}</p>
  </section>

  <section class="mt-10" aria-labelledby="categories-title">
    <h2 id="categories-title">Explora por categoría</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        categories.map((category) => (
          <li>
            <a
              href={`/categoria/${category.id}/`}
              class="block rounded-2xl border-2 border-border bg-surface p-4 no-underline shadow-[var(--shadow-card)] transition-transform duration-150 ease-out hover:-translate-y-0.5"
            >
              <span class="block font-display text-xl font-bold">{category.label}</span>
              <span class="block text-fg-muted">{category.count} palabras</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script id="daily-data" type="application/json" set:html={JSON.stringify(list)} />
  <script>
    import { dayIndex } from "../lib/text";

    type DailyWord = { id: string; term: string; definition: string };

    const dataEl = document.getElementById("daily-data");
    const link = document.querySelector<HTMLAnchorElement>("[data-daily-link]");
    const definition = document.querySelector<HTMLElement>("[data-daily-definition]");

    if (dataEl?.textContent && link && definition) {
      try {
        const list = JSON.parse(dataEl.textContent) as DailyWord[];
        if (list.length > 0) {
          const word = list[dayIndex(new Date(), list.length)];
          if (word) {
            link.textContent = word.term;
            link.href = `/palabra/${word.id}/`;
            definition.textContent = word.definition;
          }
        }
      } catch {
        // Keep the word chosen at build time.
      }
    }
  </script>
</Base>
