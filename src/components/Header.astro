---
import { SITE_NAME } from "../lib/site";

const links = [
  { label: "Inicio", href: "/" },
  { label: "A–Z", href: "/a-z/" },
  { label: "Buscar", href: "/buscar/" },
  { label: "Acerca", href: "/acerca/" },
];
---
<header class="border-b-2 border-border bg-surface">
  <div class="mx-auto flex w-full max-w-[68rem] flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2 sm:px-6">
    <a href="/" class="font-display text-xl font-extrabold no-underline">{SITE_NAME}</a>
    <nav aria-label="Principal">
      <ul class="flex flex-wrap items-center gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center rounded-full px-3 font-medium transition-colors duration-150 ease-out hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
